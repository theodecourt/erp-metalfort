SUPABASE_URL=http://127.0.0.1:54321
# New Supabase key system (use values from `supabase status` output)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# JWT signing secret for validating Supabase Auth tokens (still used by the new system)
SUPABASE_JWT_SECRET=super-secret-jwt-token-...
RESEND_API_KEY=
ALLOWED_ORIGINS=http://localhost:5173
METALFORT_NOTIFICATION_EMAIL=theo@metalfort.tech

# Google Cloud Document AI (parse de NF via foto)
# 1. Crie service account com role "Document AI API User"
# 2. Baixe a chave JSON e salve em backend/secrets/ (ignorado pelo git)
# 3. Habilite a API "documentai.googleapis.com" no projeto
GOOGLE_APPLICATION_CREDENTIALS=secrets/google-document-ai.json
GOOGLE_CLOUD_PROJECT=metalfort-erp
DOCAI_LOCATION=us
DOCAI_PROCESSOR_ID=your-processor-id-here
